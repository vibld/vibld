{
  "name": "vibld",
  "version": "0.0.0",
  "private": true,
  "description": "The open-source AI builder for portable, Git-native web applications.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
