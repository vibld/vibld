{
  "name": "vibld-web-preview",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],

  // The Worker handles /api/* only; everything else is served straight from
  // the built SPA. Explicit routing is used rather than the implicit
  // Sec-Fetch-Mode heuristic so an API path can never fall through to
  // index.html.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // ANTHROPIC_API_KEY is a Worker secret, set out of band and never committed.
  // Both Access values must also be present or /api/plan refuses every
  // request: an open endpoint here would let anyone spend the model budget.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
  },
}
