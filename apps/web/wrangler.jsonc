{
  "name": "vibld-web-preview",
  "compatibility_date": "2026-09-07",
  // enable_request_signal makes request.signal fire on client disconnect, which
  // is how /api/plan learns to abort its model call. The flag has no "default
  // as of" date in Cloudflare's table, so no compatibility_date turns it on.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],

  // The Worker handles /api/* only; everything else is served straight from
  // the built SPA. Explicit routing is used rather than the implicit
  // Sec-Fetch-Mode heuristic so an API path can never fall through to
  // index.html.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // ANTHROPIC_API_KEY is a Worker secret, set out of band and never committed.
  //
  // The two values below are public identifiers rather than secrets: the team
  // domain is the Access login hostname and the AUD tag names the Access
  // application. /api/plan verifies each request's Access token against them,
  // and refuses every request unless all three are present.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "chris-brock-llc.cloudflareaccess.com",
    "ACCESS_AUD": "5d652184451045c3fde8eca6a09ebaa59fd4704666b94d839bebde5cf992d5d7",
  },
}
