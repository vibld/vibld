# Secrets and out-of-band settings for the builder Worker.
#
# Everything here is set outside the repository. Every value is left empty
# on purpose and its shape described in the comment above it, rather than
# filled with a convincing-looking fake: a placeholder shaped like a real
# key trips secret scanners and can be mistaken for one. Never commit a
# real key to this file.
#
#   Local development   copy to .dev.vars, which is gitignored
#   Deployed            wrangler secret put <NAME>
#                       https://dash.cloudflare.com/?to=/:account/workers/services/view/vibld-web-preview/production/settings
#
# Settings that are not secret live in wrangler.jsonc's "vars" block instead,
# alongside the comment explaining what each one costs to get wrong. Two of
# them matter before anything below will work: CLERK_FRONTEND_API_URL, and
# VIBLD_PROVIDER, which decides which of the model keys is the required one.
#
# Resource bindings (DB, PROJECT_CONTENT, USER_BUDGET, GENERATION_WORKFLOW,
# PREVIEW, PUBLISH, the rate limiters) are declared in wrangler.jsonc and are
# not environment variables. They are not listed here.

# --- Required: sign-in -------------------------------------------------
#
# Without Clerk, generation is unavailable and says so. That failure is
# closed on purpose: an unauthenticated generation endpoint on a public URL
# lets anybody spend this deployment's model budget (worker/principal.ts).

# Clerk backend key, for the admin invite route's calls to Clerk.
# Shape: sk_test_... (test) or sk_live_... (production)
CLERK_SECRET_KEY=

# Clerk publishable key. Read at build time by Vite, not by the Worker, so it
# is set in the build environment rather than with `wrangler secret put`.
# Shape: pk_test_... or pk_live_...
VITE_CLERK_PUBLISHABLE_KEY=

# --- Required: one model provider --------------------------------------
#
# Which one is required is decided by VIBLD_PROVIDER in wrangler.jsonc. The
# others can be absent; a model the deployment cannot serve is never offered
# (packages/ai/src/select-client.ts).

DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Optional: preview and publish -------------------------------------
#
# Shared secrets on the service bindings to the preview and publish Workers.
# Both halves must be present or the feature reports itself unconfigured
# rather than half-working (worker/preview-client.ts, publish-client.ts).
# Generate with: openssl rand -hex 32

PREVIEW_INTERNAL_SECRET=
PUBLISH_INTERNAL_SECRET=

# --- Optional: billing --------------------------------------------------
#
# Absent means no paid tiers, no top-ups and no referral payouts. Everything
# billing touches is behind a configured check, so a deployment without these
# runs on the free tier alone.
#
# The webhook must be subscribed to checkout.session.completed,
# checkout.session.async_payment_succeeded / _failed,
# customer.subscription.created / .updated / .deleted, invoice.paid,
# invoice.payment_failed, charge.refunded and charge.dispute.closed.
# The last two are what take a referral reward back; see apps/web/README.md.
# https://dashboard.stripe.com/webhooks

# Shapes: sk_test_... / sk_live_..., and whsec_... for the webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Origin the referral links point at. Defaults to the request's own origin.
VIBLD_APP_ORIGIN=https://app.example.com

# Credit granted once per account on first sign-in, in USD cents. Unset
# means no signup credit.
VIBLD_SIGNUP_CREDIT_USD_CENTS=100
VIBLD_SIGNUP_CREDIT_FROM=system@example.com

# --- Optional: GitHub integration ---------------------------------------
#
# Pushing a generated project to a repository. All four are needed together.
# The private key is the .pem GitHub gives you once, newlines included; it is
# a credential that grants repository write, so treat it accordingly.
# https://github.com/settings/apps

VIBLD_GITHUB_APP_ID=
VIBLD_GITHUB_CLIENT_ID=
VIBLD_GITHUB_CLIENT_SECRET=
VIBLD_GITHUB_PRIVATE_KEY=

# --- Optional: operations ------------------------------------------------

# Who may reach the admin routes: comma-separated email addresses. Unset
# means the admin panel is unavailable rather than open.
VIBLD_PLATFORM_ADMINS=you@example.com

# "invite" gates sign-in behind the invite list; "open" does not.
VIBLD_ACCESS_MODE=invite

# Nightly provider-balance alert. Needs a Resend key to send anything.
# https://resend.com/api-keys
RESEND_API_KEY=
VIBLD_ALERT_EMAIL=you@example.com
VIBLD_ALERT_FROM=alerts@example.com
VIBLD_DEEPSEEK_BALANCE_ALERT_USD=20

# --- Optional: overrides you should not need -----------------------------
#
# Each of these overrides something with a working default. Setting one to a
# wrong value is worse than leaving it unset: the price overrides in
# particular ceiling every run against a rate the chosen model does not
# charge, which is how a budget that affords forty generations a day came to
# afford two.

# Whole-account spend ceiling per day, in micro-USD.
VIBLD_ACCOUNT_DAILY_MICRO_USD=

# The Free tier's monthly included spend, in micro-USD. Its default already
# matches the published price table. Build and Ship are not configurable.
VIBLD_FREE_MONTHLY_MICRO_USD=

# Which models each principal may use, as JSON. See packages/ai/src/model-policy.ts.
VIBLD_MODEL_POLICY=

# Per-token list prices, in micro-USD. Correct a catalogue rate, nothing else.
VIBLD_USD_MICRO_PER_INPUT_TOKEN=
VIBLD_USD_MICRO_PER_OUTPUT_TOKEN=

# Milliseconds between keepalives on the generation stream.
VIBLD_STREAM_KEEPALIVE_MS=
