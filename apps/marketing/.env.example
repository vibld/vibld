# Public site origin. Used to build absolute URLs for canonical links and
# social card metadata, which crawlers require to be absolute.
#
# Copy this file to .env for local development. Production sets this at
# deploy time; see wrangler.jsonc.
VITE_SITE_URL=https://vibld.com

# --- Worker secrets, not build-time vars -------------------------------
# These are never read from .env. They are Worker secrets, set with
# `wrangler secret put` (or synced by CI -- see
# .github/workflows/deploy-marketing.yml) and are listed here only so a
# reader knows they exist.
#
# TURNSTILE_SECRET_KEY  Cloudflare Turnstile secret, used server-side by
#                        /api/roadmap/vote to verify a vote's token.
