    "typecheck": "react-router typegen && tsc",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "@react-router/node": "8.4.0",
    "@vibld/ai": "workspace:*",
    "@vibld/brand": "workspace:*",
