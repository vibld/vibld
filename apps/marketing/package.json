  "scripts": {
    "brand:assets": "node --experimental-strip-types scripts/brand-assets.ts",
    "build": "react-router build && node --experimental-strip-types scripts/postbuild.ts",
    "deploy": "pnpm dlx wrangler@4.137.0 deploy",
    "dev": "react-router dev",
    "indexnow": "node --experimental-strip-types scripts/indexnow-submit.ts",
