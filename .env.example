# Settings for `docker compose up` (docker-compose.yml). Copy this file to
# .env and fill it in; .env is ignored by git.

# The password you sign in with, 12 characters or more.
VIBLD_OWNER_PASSWORD=

# A model key: at least one, or a local model below, or add a key later on
# the admin page under Provider keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# A model on your own machine instead of, or as well as, a key (README.md,
# "Local models"). Any server that answers OpenAI's chat completions API:
# Ollama, LM Studio or llama.cpp. vibld runs on your machine's network, so
# localhost here is your machine.
#   Ollama     http://localhost:11434/v1
#   LM Studio  http://localhost:1234/v1
#   llama.cpp  http://localhost:8080/v1
VIBLD_LOCAL_BASE_URL=
# The model's name on that server, for example qwen3-coder:30b.
VIBLD_LOCAL_MODEL=
# Only for a server started with an API key.
VIBLD_LOCAL_API_KEY=

# Which provider answers a build that names no model: openai, anthropic,
# deepseek or local. Leave it blank to use the only one you set. And,
# optionally, the model itself.
VIBLD_PROVIDER=
VIBLD_MODEL=

# Optional. Leave these blank unless you need them.
#
# Your email, so the admin page names you rather than "owner@localhost".
VIBLD_OWNER_EMAIL=
# Micro-dollars the Free plan may spend a month, if not $1.00 (1000000).
VIBLD_FREE_MONTHLY_MICRO_USD=

# Your own GitHub App, to create or push to a GitHub repository for each
# project. Leave all five blank to go without. README.md, "Pushing to
# GitHub", says how to make the App; its callback URL here is
# http://localhost:8787/api/github/callback.
VIBLD_GITHUB_APP_ID=
# The .pem GitHub downloads, on one line in double quotes with \n for each
# line break: "-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
# (from a terminal: awk 'NF {printf "%s\\n", $0}' key.pem).
VIBLD_GITHUB_PRIVATE_KEY=
VIBLD_GITHUB_CLIENT_ID=
VIBLD_GITHUB_CLIENT_SECRET=
# Only if GitHub can reach this machine to report a merged pull request.
VIBLD_GITHUB_WEBHOOK_SECRET=
