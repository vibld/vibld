# Settings for `docker compose up` (docker-compose.yml). Copy this file to
# .env and fill it in; .env is ignored by git.

# The password you sign in with, 12 characters or more.
VIBLD_OWNER_PASSWORD=

# A model key: at least one, or add one later on the admin page under
# Provider keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Which provider answers a build that names no model: openai, anthropic or
# deepseek. And, optionally, the model itself.
VIBLD_PROVIDER=openai
VIBLD_MODEL=
